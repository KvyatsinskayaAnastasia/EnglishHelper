# Скопируйте в .env на компьютере, где запущен бот.
# Файл .env в git не входит.

# Образ из Docker Hub, без сборки на этой машине.
# username — тот же, что секрет DOCKER_USERNAME в GitHub.
DOCKER_IMAGE=username/english:latest

SERVER_PORT=8181
# Хост english-db — имя сервиса в docker-compose, не localhost.
SPRING_DATASOURCE_URL=jdbc:postgresql://english-db:5432/english
REDIS_HOST=redis

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

POSTGRES_DB=english
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
