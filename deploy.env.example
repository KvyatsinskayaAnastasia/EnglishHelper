# Скопируйте в deploy.env на компьютере, где ведётся разработка.
# Файл deploy.env в git не входит.

# SSH к компьютеру, где крутится бот.
DEPLOY_HOST=192.168.1.10
DEPLOY_USER=user
# Каталог на том компьютере: там лежат docker-compose.yml и .env.
# Без пробелов.
DEPLOY_PATH=/home/user/english

# Репозиторий образа без тега. Совпадает с DOCKER_USERNAME/english.
DOCKER_REPO=username/english

# Необязательно. Путь к приватному ключу, если он не подхватывается ssh сам.
# DEPLOY_SSH_KEY=C:\Users\you\.ssh\id_ed25519

# bash — Linux и macOS. powershell — если SSH на компьютере с ботом открывает PowerShell.
DEPLOY_SHELL=bash
